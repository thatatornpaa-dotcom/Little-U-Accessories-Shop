model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Hashed password
  firstName String?
  lastName  String?
  phone     String?
  address   String?
  role      String   @default("BUYER") // "BUYER", "SELLER", "ADMIN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop           Shop?
  cart           Cart?
  orders         Order[]
  wishlist       WishlistItem[]
  addresses      Address[]
  reviews        Review[]
  refundRequests RefundRequest[]
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("ที่บ้าน") // "ที่บ้าน", "ที่ทำงาน"
  recipientName String
  phone         String
  province      String
  amphoe        String? // เขต / อำเภอ
  tambon        String? // แขวง / ตำบล
  addressLine   String // บ้านเลขที่ ซอย ถนน
  postalCode    String
  note          String? // หมายเหตุผู้จัดส่ง
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Employee {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Hashed password
  firstName String?
  lastName  String?
  role      String   @default("staff") // "admin", "staff"
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

